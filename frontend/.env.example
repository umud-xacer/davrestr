# Backend API manzili (oxirida /api/v1 bilan). Build vaqtida Vite tomonidan bundle ichiga
# kiritiladi — shuning uchun bu qiymat Vercel'da Environment Variable sifatida ham,
# build muhitida ham to'g'ri sozlangan bo'lishi kerak.
#
# Lokal ishlab chiqish uchun (backend localhost:8000 da ishlayapti bo'lsa):
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Production (Vercel) uchun namuna — backend alohida serverda (docker-compose.prod.yml,
# Caddy orqali) joylashgan bo'lsa, uning ochiq domenini ko'rsating:
# VITE_API_BASE_URL=https://api.davreestr-domeningiz.uz/api/v1
