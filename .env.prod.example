# Bu faylni serverda ".env" nomi bilan saqlang (git'ga hech qachon commit qilmang).
# Barcha qiymatlarni haqiqiy, kuchli maxfiy qiymatlar bilan almashtiring.

DOMAIN=davrestr.uz

POSTGRES_USER=davreestr_prod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
POSTGRES_DB=davreestr

# Generatsiya qilish uchun serverda: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Eslatma: SEED_PASSWORD bu faylga yozilmaydi — faqat `python -m app.seed --production`
# ishga tushirilganda bir martalik environment o'zgaruvchi sifatida uzatiladi (pastga qarang, DEPLOY.md).
